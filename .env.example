# Env deploy (Dokploy / docker compose). Salin nilainya ke tab Environment Dokploy.
# Bentuk: KEY=value. Jangan commit nilai asli (file `.env` sudah di-gitignore).

# ── Backend ───────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta
ROTATION_CONFIG=/app/config/default.yaml
DATABASE__PATH=/app/data/rotation.db
API__HOST=0.0.0.0
API__PORT=8000
# Kunci untuk /admin/* (docs/05 §4.5): isi string acak panjang, lalu tempel di UI (localStorage).
# KOSONG = /admin/* terbuka → siapa pun bisa memicu ingest/backfill 962 emiten.
API__API_KEY=
# Hanya bila backend diberi domain sendiri; UI lewat proxy nginx (satu origin) tidak butuh CORS.
# Contoh: API__CORS_ORIGINS=["https://api.rotasi.domainmu.com"]
API__CORS_ORIGINS=[]
APP__TIMEZONE=Asia/Jakarta
# Opsional — percepat backfill pertama & atur beban ke Yahoo.
INGEST__DAILY_LOOKBACK_DAYS=730
INGEST__BATCH_SIZE=50

# ── Frontend ──────────────────────────────────────────────────────────────────
# Target proxy nginx untuk `/api` dan `/health` (nama service di docker-compose.yml).
BACKEND_ORIGIN=http://backend:8000
