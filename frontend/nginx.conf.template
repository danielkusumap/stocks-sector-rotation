# Disajikan nginx di container frontend. `${BACKEND_ORIGIN}` diisi envsubst oleh entrypoint resmi
# image nginx (default http://backend:8000) — hanya variabel yang ADA di environment yang diganti,
# jadi variabel nginx seperti $uri/$host tetap utuh.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Basic auth untuk seluruh UI + API lewat proxy (permintaan owner). File dibuat saat start
    # oleh /docker-entrypoint.d/15-basic-auth.envsh dari env BASIC_AUTH_USER/BASIC_AUTH_PASSWORD.
    auth_basic "Sector Rotation IDX";
    auth_basic_user_file /etc/nginx/.htpasswd;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Aset ber-hash dari Vite boleh di-cache lama; index.html tidak (agar rilis baru langsung terpakai).
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Satu origin dengan UI → tidak ada CORS. Timeout longgar: beberapa endpoint admin memicu run
    # ingest yang bisa berjalan lama (frontend tetap polling status run, bukan menahan request).
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
    location = /health {
        proxy_pass ${BACKEND_ORIGIN}/health;
    }
    # Dipakai HEALTHCHECK image (tidak menyentuh backend). Tanpa auth: healthcheck Docker tidak kirim kredensial.
    location = /healthz {
        auth_basic off;
        access_log off;
        return 200 "ok\n";
    }

    # SPA: rute lain (mis. /weekly, /data) dilayani index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
