{
  "name": "sector-rotation-idx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "spec": "playwright test",
    "gate": "npm run typecheck && vitest run && playwright test --grep-invert \"@a11y|@slow\"",
    "gate:full": "npm run typecheck && vitest run && playwright test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "msw": "^3.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
